# Copy to .env for local Docker Compose. Never commit .env.
# These are development defaults only; production values must come from the hosting environment.

# PostgreSQL container
POSTGRES_DB=libra
POSTGRES_USER=libra
POSTGRES_PASSWORD=libra_dev
# Host port. 5432/5433/5434 are commonly occupied by local PostgreSQL installs.
POSTGRES_PORT=5440

# API container (only with: docker compose --profile api up)
API_PORT=5134
ASPNETCORE_ENVIRONMENT=Production
# Required outside Development: at least 32 random bytes, e.g. from `openssl rand -base64 48`. Never commit a real value.
JWT_SIGNING_KEY=

# When running the API with `dotnet run`, configure the connection string via user-secrets or:
# ConnectionStrings__Libra=Host=localhost;Port=5440;Database=libra;Username=libra;Password=libra_dev
# Optional in Development (an ephemeral key is generated when absent):
# Jwt__SigningKey=<at least 32 bytes>
