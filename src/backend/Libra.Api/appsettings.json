{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Jwt": {
    "Issuer": "libra",
    "Audience": "libra-mobile"
  },
  "RateLimiting": {
    "Register": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Login": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Refresh": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
