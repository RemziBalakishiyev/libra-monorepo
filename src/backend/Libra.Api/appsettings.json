{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Jwt": {
    "Issuer": "libra",
    "Audience": "libra-mobile"
  },
  "RateLimiting": {
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Ai": {
    "OpenAi": {
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-5.6-luna",
      "ImageDetail": "auto"
    },
    "FoodAnalysis": {
      "MaxUploadBytes": 8388608,
      "MaxStoredDimension": 1024,
      "DraftLifetimeMinutes": 120,
      "ImageRetentionMinutes": 120,
      "CleanupIntervalMinutes": 15,
      "MaxAnalysesPerHour": 20,
      "MaxConcurrentAnalyses": 4,
      "TimeoutSeconds": 45,
      "MaxOutputTokens": 1200,
      "UseDevelopmentFixture": false
    },
    "Assistant": {
      "MaxQuestionsPerHour": 30,
      "TimeoutSeconds": 40,
      "MaxOutputTokens": 900,
      "MaxHistoryTurns": 6,
      "QueueSeconds": 5,
      "UseDevelopmentFixture": false
    }
  },
  "Storage": {
    "ImagesPath": ""
  }
}
